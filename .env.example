# Copy to .env and fill in identifiers only. Never put secrets, connection
# strings, keys, or passwords in this file or in .env — every value below is
# an ID/name/URI that DefaultAzureCredential (az login) resolves at runtime,
# not a credential itself.

AZURE_SUBSCRIPTION_ID=
RESOURCE_GROUP=rg-fabric-medallion-multisourcev2-poc-westus3

# --- Fabric ---
FABRIC_CAPACITY_NAME=fabricmsv2poc915d
FABRIC_WORKSPACE_NAME=fabric-medallion-multisourcev2-poc
GITHUB_REPO=regshih/fabric-medallion-multisourcev2-poc

# --- Azure Databricks ---
DATABRICKS_WORKSPACE_NAME=dbw-fmv2poc-915d
DATABRICKS_HOST=https://adb-7405604763364719.19.azuredatabricks.net
DATABRICKS_WORKSPACE_RESOURCE_ID=/subscriptions/<sub-id>/resourceGroups/rg-fabric-medallion-multisourcev2-poc-westus3/providers/Microsoft.Databricks/workspaces/dbw-fmv2poc-915d
# UNITY_CATALOG_NAME reuses the workspace's auto-provisioned default catalog
# (see docs/databricks-fabric-integration.md for why) rather than a new one.
UNITY_CATALOG_NAME=dbw_fmv2poc_915d
UNITY_CATALOG_SCHEMA=banking
UNITY_CATALOG_VOLUME=landing

# --- Azure Cosmos DB for NoSQL ---
COSMOS_ACCOUNT_NAME=
COSMOS_ENDPOINT=                  # https://<account>.documents.azure.com:443/
COSMOS_DATABASE_NAME=multisource

# --- Synthetic data scale ---
TRANSACTION_ROWS=750000
CUSTOMER_COUNT=25000
MERCHANT_COUNT=1500

DATA_OUT_DIR=./data
